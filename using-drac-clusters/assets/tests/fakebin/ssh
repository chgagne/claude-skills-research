#!/bin/sh
# Fake ssh for the tests. Never touches the network.
# FAKE_SSH_MODE: ok (default) | fail | hang | stale | failrun | hangcheck
#   failrun: -O check succeeds, the remote run fails (socket died in between)
#   hang: -O check succeeds, the remote run hangs; hangcheck: -O check hangs
# FAKE_SSH_CONTROLPATH: what `ssh -G` reports as controlpath (default none).
printf "%s\n" "ssh $*" >> "${FAKEBIN_LOG:-/dev/null}"
printf 'fakessh-env SSH_ASKPASS=%s DISPLAY=%s SSH_ASKPASS_REQUIRE=%s\n' \
    "${SSH_ASKPASS-<unset>}" "${DISPLAY-<unset>}" "${SSH_ASKPASS_REQUIRE-<unset>}" \
    >> "${FAKEBIN_LOG:-/dev/null}"
here=$(cd "$(dirname "$0")" && pwd)
mode=${FAKE_SSH_MODE:-ok}

query=
check=
host=
while [ $# -gt 0 ]; do
    case "$1" in
        -G) query=1 ;;
        -O) shift; [ "${1:-}" = check ] && check=1 ;;
        -o | -F | -p | -l | -i | -J) shift ;;
        -*) ;;
        *) [ -n "$host" ] || host=$1 ;;
    esac
    shift
done

if [ -n "$query" ]; then
    printf 'user remoteuser\nhostname %s.example.invalid\nport 22\n' "$host"
    printf 'controlpath %s\n' "${FAKE_SSH_CONTROLPATH:-none}"
    exit 0
fi

case "$mode" in
    failrun | hang)
        if [ -n "$check" ]; then
            echo "Master running (pid=12345)" >&2
            exit 0
        fi
        ;;
esac
[ "$mode" = failrun ] && mode=fail
[ "$mode" = hangcheck ] && mode=hang

case "$mode" in
    ok)
        if [ -n "$check" ]; then
            echo "Master running (pid=12345)" >&2
            exit 0
        fi
        PATH="$here:/usr/bin:/bin" exec bash -s
        ;;
    fail)
        echo "Control socket connect(/tmp/fake-socket): No such file or directory" >&2
        echo "Permission denied (keyboard-interactive)." >&2
        exit 255
        ;;
    stale)
        echo "Control socket connect(/tmp/fake-socket): Connection refused" >&2
        echo "mux_client_request_session: read from master failed: Broken pipe" >&2
        exit 255
        ;;
    hang)
        # the child pid lets the tests check the whole process group was killed
        sleep 300 &
        echo $! > "${FAKEBIN_LOG:-/dev/null}.child"
        wait
        exit 0
        ;;
esac
exit 255
